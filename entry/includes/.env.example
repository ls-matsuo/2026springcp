# メール送信（SMTP）
# 本ファイルを .env にコピーし、利用する SMTP サーバに合わせて設定する。
# 値に空白を含む場合は "" で囲む（例: MAIL_FROM_NAME="ENEOS Charge Plus"）。

MAIL_HOST=          # 例: smtp.example.com
MAIL_PORT=          # 例: 465, 587, 25
MAIL_AUTH=          # AUTH認証する場合は true（未設定・空も false 扱い）
MAIL_USER=          # 認証時のユーザー名（空なら MAIL_AUTH=false に）
MAIL_PASS=          # 認証時のパスワード
MAIL_SECURE=        # 例: tls, ssl（なしなら空）
MAIL_FROM=          # 送信元メールアドレス
MAIL_FROM_NAME=     # 送信元表示名
